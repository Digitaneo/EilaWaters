<div class="contact-page-wrapper container ew-contact-rtl" style="--primary-color: #00c7f2; --text-dark: #1e293b;">
  
  <header class="contact-header">
    <h1 class="contact-main-title">{{ section.settings.heading | default: 'تواصل معنا' }}</h1>
    <p class="contact-sub-title">{{ section.settings.subheading | default: 'يسعدنا دائماً الإجابة على استفساراتكم وتلقي آرائكم. اختر الطريقة المناسبة لك.' }}</p>
  </header>

  <div class="contact-grid-layout">
    
    <div class="contact-form-block">
      <h3 class="block-title">✉️ أرسل لنا رسالة مباشرة</h3>
      
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div class="contact-alert alert-success">
            ✓ تم إرسال رسالتك بنجاح! سيتواصل معك فريق الدعم الفني خلال 24 ساعة.
          </div>
        {%- elsif form.errors -%}
          <div class="contact-alert alert-error">
            ⚠️ عذراً، حدث خطأ أثناء إرسال الرسالة. يرجى التحقق من الحقول والمحاولة مرة أخرى.
          </div>
        {% endif %}

        <div class="form-row-grid">
          <div class="form-group">
            <label for="ContactFormName">الاسم الكريم <span class="required-star">*</span></label>
            <input type="text" id="ContactFormName" name="contact[name]" placeholder="أدخل اسمك الكامل" required>
          </div>
          
          <div class="form-group">
            <label for="ContactFormEmail">البريد الإلكتروني <span class="required-star">*</span></label>
            <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="example@domain.com" spellcheck="false" autocomplete="off" capitalize="off" required>
          </div>
        </div>

        <div class="form-row-grid">
          <div class="form-group">
            <label for="ContactFormPhone">رقم الجوال (اختياري)</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="05xxxxxxxx">
          </div>
          <div class="form-group">
            <label for="ContactFormSubject">موضوع الرسالة <span class="required-star">*</span></label>
            <select id="ContactFormSubject" name="contact[subject]" required>
              <option value="" disabled selected>اختر سبب التواصل</option>
              <option value="استفسار عن طلب">📦 استفسار عن طلب قائم</option>
              <option value="مشكلة في الدفع">💳 مشكلة في الدفع أو السلة</option>
              <option value="اقتراح أو شكوى">📝 اقتراح أو شكوى</option>
              <option value="شراكة وأعمال">🤝 طلب شراكة أو كميات (جملة)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="ContactFormMessage">نص الرسالة <span class="required-star">*</span></label>
          <textarea rows="6" id="ContactFormMessage" name="contact[body]" placeholder="اكتب تفاصيل استفسارك هنا..." required></textarea>
        </div>

        <button type="submit" class="contact-submit-btn">🚀 إرسال الرسالة الآن</button>
      {% endform %}
    </div>

    <div class="contact-info-sidebar">
      
      {% if section.settings.whatsapp_number != blank %}
        <div class="info-card whatsapp-highlight-card">
          <div class="card-icon">💬</div>
          <div class="card-text">
            <h4>الدعم الفني السريع (واتساب)</h4>
            <p>لردود فورية حول طلبك، تواصل معنا مباشرة:</p>
            <a href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" class="card-action-link">تحدث معنا الآن</a>
          </div>
        </div>
      {% endif %}

      <div class="info-card">
        <div class="card-icon">📍</div>
        <div class="card-text">
          <h4>المقر الرئيسي</h4>
          <p>{{ section.settings.address_text | default: 'المملكة العربية السعودية، مكة المكرمة' }}</p>
        </div>
      </div>

      <div class="info-card">
        <div class="card-icon">✉️</div>
        <div class="card-text">
          <h4>البريد الإلكتروني المباشر</h4>
          <p><a href="mailto:contact@eilawaters.com</a></p>
        </div>
      </div>

      <div class="info-card">
        <div class="card-icon">🕒</div>
        <div class="card-text">
          <h4>أوقات العمل واستقبال الاستفسارات</h4>
          <p>{{ section.settings.work_hours | default: 'من الأحد إلى الخميس: 9:00 صباحاً - 5:00 مساءً' }}</p>
        </div>
      </div>

    </div>

  </div>

  <div class="contact-faq-section">
    <h3 class="faq-main-title">❓ أسئلة شائعة قبل التواصل</h3>
    <div class="faq-grid">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div class="faq-item-box">
            <h4>{{ block.settings.question }}</h4>
            <p>{{ block.settings.answer }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

</div>

<style>
  .ew-contact-rtl {
    direction: rtl !important;
    text-align: right;
    font-family: inherit;
  }
  
  .contact-page-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 15px;
    box-sizing: border-box;
  }

  /* الرأس */
  .contact-header {
    text-align: center;
    margin-bottom: 45px;
  }
  .contact-main-title {
    font-size: 32px;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0 0 12px 0;
  }
  .contact-sub-title {
    font-size: 16px;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* التخطيط الشبكي للنموذج والمعلومات */
  .contact-grid-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 40px;
    align-items: start;
    margin-bottom: 60px;
  }

  /* حاوية النموذج */
  .contact-form-block {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 35px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }
  .block-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0 0 25px 0;
  }

  /* التنبيهات */
  .contact-alert {
    padding: 15px 20px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 25px;
  }
  .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
  .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

  /* عناصر الإدخال */
  .form-row-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }
  .form-group label {
    font-size: 14px;
    font-weight: 700;
    color: #334155;
  }
  .required-star { color: #ef4444; margin-right: 2px; }
  
  .form-group input, 
  .form-group select, 
  .form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 14px;
    background: #f8fafc;
    color: var(--text-dark);
    box-sizing: border-box;
    transition: all 0.3s ease;
  }
  .form-group input:focus, 
  .form-group select:focus, 
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(0, 199, 242, 0.15);
  }
  .form-group select {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23475569' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='6 9 12 15 18 9'%3E%3C/polyline%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: left 12px center;
    background-size: 16px;
    padding-left: 40px;
  }

  /* زر الإرسال */
  .contact-submit-btn {
    background: var(--primary-color);
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    border: none;
    padding: 14px 30px;
    border-radius: 12px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 199, 242, 0.25);
    transition: all 0.2s ease;
    width: auto;
    display: inline-block;
  }
  .contact-submit-btn:hover {
    transform: translateY(-2px);
    filter: brightness(0.95);
  }

  /* الشريط الجانبي للمعلومات */
  .contact-info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .info-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
    display: flex;
    gap: 15px;
    align-items: flex-start;
  }
  .whatsapp-highlight-card {
    border-color: #25d366;
    background: #f0fdf4;
  }
  .info-card .card-icon {
    font-size: 24px;
    background: #f1f5f9;
    width: 45px;
    height: 45px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .whatsapp-highlight-card .card-icon {
    background: #25d366;
    color: white;
  }
  .card-text h4 {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0 0 6px 0;
  }
  .card-text p {
    font-size: 13px;
    color: #475569;
    margin: 0;
    line-height: 1.5;
  }
  .card-text p a {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }
  .card-action-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #166534;
    text-decoration: none;
    border-bottom: 2px solid #166534;
  }

  /* قسم الأسئلة الشائعة بالأسفل */
  .contact-faq-section {
    border-top: 1px solid #e2e8f0;
    padding-top: 50px;
  }
  .faq-main-title {
    font-size: 22px;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0 0 30px 0;
    text-align: center;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
  }
  .faq-item-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
  }
  .faq-item-box h4 {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0 0 10px 0;
  }
  .faq-item-box p {
    font-size: 13px;
    color: #64748b;
    margin: 0;
    line-height: 1.6;
  }

  /* شاشات الجوال والأجهزة الذكية */
  @media (max-width: 991px) {
    .contact-grid-layout { grid-template-columns: 1fr; gap: 30px; }
    .form-row-grid { grid-template-columns: 1fr; gap: 0; }
    .faq-grid { grid-template-columns: 1fr; }
    .contact-submit-btn { width: 100%; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "صفحة اتصل بنا الاحترافية",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان الرئيسي",
      "default": "تواصل معنا"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "العنوان الفرعي",
      "default": "يسعدنا دائماً الإجابة على استفساراتكم وتلقي آرائكم. اختر الطريقة المناسبة لك."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "رقم الواتساب الدولي (بدون أصفار أو +)",
      "placeholder": "966500000000",
      "info": "مثال: 966500000000"
    },
    {
      "type": "text",
      "id": "address_text",
      "label": "العنوان الفعلي للشركة",
      "default": "المملكة العربية السعودية، مكة المكرمة"
    },
    {
      "type": "text",
      "id": "work_hours",
      "label": "أوقات الدعم والعمل",
      "default": "من الأحد إلى الخميس: 9:00 صباحاً - 5:00 مساءً"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "سؤال شائع",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "السؤال",
          "default": "كم يستغرق توصيل الطلب؟"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "الإجابة الشائعة",
          "default": "يستغرق شحن الطلبات وتوصيلها داخل مكة المكرمة وباقي مدن المملكة من 2 إلى 5 أيام عمل كحد أقصى."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "صفحة اتصل بنا الاحترافية",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}