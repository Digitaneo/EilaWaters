{{ 'artiz-blog.css' | asset_url | stylesheet_tag }}

<style>
  /* 1. إخفاء عنوان الصفحة الرئيسي المقتطع وأزرار التصنيفات والوسوم تماماً */
  .artiz-blog-page__title,
  .artiz-blog__tags,
  .artiz-blog__tags-list {
    display: none !important;
  }

  /* 2. إضافة مسافات أمان جانبية للصفحة بالكامل ومنع الالتصاق بالحواف */
  .artiz-blog-page {
    max-width: 1240px !important;
    margin: 0 auto !important;
    padding: 40px 24px !important; /* مسافة أمان ممتازة يميناً ويساراً */
    box-sizing: border-box !important;
  }

  /* 3. تحويل شبكة المقالات إلى 3 أعمدة (3 مقالات في السطر) */
  .artiz-blog__grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 30px !important; /* تباعد بين المقالات */
    margin-top: 20px !important;
  }

  /* 4. جعل التصميم متجاوباً بالكامل مع الشاشات المختلفة */
  @media screen and (max-width: 992px) {
    .artiz-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important; /* مقالين في السطر للتابلت */
    }
    .artiz-blog-page {
      padding: 30px 20px !important;
    }
  }

  @media screen and (max-width: 768px) {
    .artiz-blog__grid {
      grid-template-columns: repeat(1, minmax(0, 1fr)) !important; /* مقال واحد في السطر للجوال */
      gap: 20px !important;
    }
    .artiz-blog-page {
      padding: 20px 16px !important; /* مسافة حماية مخصصة للجوال */
    }
  }
</style>

<div class="artiz-blog-page" data-section-id="{{ section.id }}">
  
  {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div class="artiz-blog__grid">
      {%- for article in blog.articles -%}
        {% render 'artiz-article-card', article: article, read_more_label: section.settings.read_more_label %}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="artiz-pagination" role="navigation">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="artiz-pagination__item">←</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="artiz-pagination__item">{{ part.title }}</a>
          {%- else -%}
            <span class="artiz-pagination__item {% if part.title == paginate.current_page %}artiz-pagination__item--active{% endif %}">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="artiz-pagination__item">→</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Custom Heading",
      "info": "Leave blank to use the default blog title (e.g. News)."
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read More"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show categories (Tags)",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Posts per page"
    }
  ]
}
{% endschema %}