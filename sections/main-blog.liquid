{{ 'artiz-blog.css' | asset_url | stylesheet_tag }}

<div class="artiz-blog-page" data-section-id="{{ section.id }}">
  <h1 class="artiz-blog-page__title">{{ section.settings.heading | default: blog.title }}</h1>

  {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
    <div class="artiz-blog__tags">
      <ul class="artiz-blog__tags-list">
        <li class="artiz-blog__tag-item">
          <a href="{{ blog.url }}" class="artiz-blog__tag-link {% if current_tags == blank %}artiz-blog__tag-link--active{% endif %}">
            {{ 'blogs.article.all_tags' | t | default: 'All' }}
          </a>
        </li>
        {%- for tag in blog.all_tags -%}
          <li class="artiz-blog__tag-item">
            {%- if current_tags contains tag -%}
              <span class="artiz-blog__tag-link artiz-blog__tag-link--active">{{ tag | link_to_remove_tag: tag }}</span>
            {%- else -%}
              <span class="artiz-blog__tag-link">{{ tag | link_to_add_tag: tag }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div class="artiz-blog__grid">
      {%- for article in blog.articles -%}
        {% render 'artiz-article-card', article: article, read_more_label: section.settings.read_more_label %}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="artiz-pagination" role="navigation">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="artiz-pagination__item">←</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="artiz-pagination__item">{{ part.title }}</a>
          {%- else -%}
            <span class="artiz-pagination__item {% if part.title == paginate.current_page %}artiz-pagination__item--active{% endif %}">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="artiz-pagination__item">→</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<style>
.artiz-blog__tags {
  margin-bottom: 3rem;
  display: flex;
  justify-content: center;
}
.artiz-blog__tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  list-style: none;
  padding: 0;
  margin: 0;
  justify-content: center;
}
.artiz-blog__tag-link, .artiz-blog__tag-link a {
  display: inline-block;
  padding: 0.5rem 1.2rem;
  border-radius: 20px;
  background: #f5f5f5;
  color: #666;
  text-decoration: none;
  font-size: 0.9rem;
  transition: all 0.3s ease;
  border: 1px solid transparent;
}
.artiz-blog__tag-link:hover, .artiz-blog__tag-link a:hover {
  background: #eee;
  color: #1a1a1a;
}
.artiz-blog__tag-link--active, .artiz-blog__tag-link--active a {
  background: #1a1a1a !important;
  color: #fff !important;
}
</style>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Custom Heading",
      "info": "Leave blank to use the default blog title (e.g. News)."
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read More"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show categories (Tags)",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Posts per page"
    }
  ]
}
{% endschema %}
