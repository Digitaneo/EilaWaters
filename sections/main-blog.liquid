{{ 'artiz-blog.css' | asset_url | stylesheet_tag }}

<style>
  /* 1. إخفاء أزرار التصنيفات والوسوم تماماً */
  .artiz-blog__tags,
  .artiz-blog__tags-list {
    display: none !important;
  }

  /* 2. تنسيق العنوان الجديد لمدونة إيلا للمياه */
  .ella-blog__main-title {
    text-align: center !important;
    color: #0c4a6e !important; /* لون كحلي داكن احترافي */
    font-size: 32px !important;
    font-weight: bold !important;
    margin-top: 20px !important;
    margin-bottom: 40px !important;
  }

  /* 3. إضافة مسافات أمان جانبية للصفحة بالكامل ومنع الالتصاق بالحواف */
  .artiz-blog-page {
    max-width: 1240px !important;
    margin: 0 auto !important;
    padding: 20px 24px 40px 24px !important; 
    box-sizing: border-box !important;
  }

  /* 4. تحويل شبكة المقالات إلى 3 أعمدة (3 مقالات في السطر) */
  .artiz-blog__grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 30px !important; 
  }

  /* إخفاء المقالات التي تتجاوز الـ 12 الأولى ليتم إظهارها عبر الزر */
  .artiz-article-card.is-hidden {
    display: none !important;
  }

  /* 5. تنسيق زر "إظهار المزيد" المخصص */
  .artiz-load-more__container {
    text-align: center;
    margin: 40px 0 20px 0;
  }

  .artiz-load-more__btn {
    background-color: #0284c7; /* لون أزرق مائي متناسق مع متجر إيلا */
    color: #ffffff;
    border: none;
    padding: 12px 35px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 25px;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease;
    box-shadow: 0 4px 6px rgba(2, 132, 199, 0.15);
  }

  .artiz-load-more__btn:hover {
    background-color: #0369a1;
    transform: translateY(-2px);
  }

  /* 6. التجاوب مع شاشات الجوال والأجهزة اللوحية */
  @media screen and (max-width: 992px) {
    .artiz-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    .ella-blog__main-title {
      font-size: 26px !important;
      margin-bottom: 30px !important;
    }
  }

  @media screen and (max-width: 768px) {
    .artiz-blog__grid {
      grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
      gap: 20px !important;
    }
    .artiz-blog-page {
      padding: 10px 16px 20px 16px !important;
    }
    .ella-blog__main-title {
      font-size: 22px !important;
      margin-bottom: 25px !important;
    }
  }
</style>

<div class="artiz-blog-page" data-section-id="{{ section.id }}">
  
  <h1 class="ella-blog__main-title">مدونة إيلا للمياه</h1>
  
  {%- paginate blog.articles by 240 -%}
    <div class="artiz-blog__grid" id="BlogArticlesGrid">
      {%- for article in blog.articles -%}
        <div class="artiz-article-item {% if forloop.index > 12 %}is-hidden{% endif %}">
          {% render 'artiz-article-card', article: article, read_more_label: 'اقرأ المزيد' %}
        </div>
      {%- endfor -%}
    </div>

    {%- if blog.articles_count > 12 -%}
      <div class="artiz-load-more__container">
        <button type="button" id="LoadMoreBtn" class="artiz-load-more__btn">إظهار المزيد</button>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const loadMoreBtn = document.getElementById('LoadMoreBtn');
    if (!loadMoreBtn) return;

    loadMoreBtn.addEventListener('click', function() {
      const hiddenArticles = document.querySelectorAll('.artiz-article-item.is-hidden');
      const itemsToShow = 12;
      
      for (let i = 0; i < itemsToShow && i < hiddenArticles.length; i++) {
        hiddenArticles[i].classList.remove('is-hidden');
      }

      const remainingHidden = document.querySelectorAll('.artiz-article-item.is-hidden');
      if (remainingHidden.length === 0) {
        loadMoreBtn.style.display = 'none';
      }
    });
  });
</script>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Custom Heading",
      "info": "Leave blank to use the default blog title (e.g. News)."
    }
  ]
}
{% endschema %}