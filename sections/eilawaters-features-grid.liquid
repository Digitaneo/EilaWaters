{%- liquid
  assign is_rtl = false
  if request.locale.iso_code contains 'ar'
    assign is_rtl = true
  endif
-%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

  .ew-grid-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    direction: rtl;
  }

  .ew-grid-section-{{ section.id }},
  .ew-grid-section-{{ section.id }} * {
    font-family: 'Cairo', sans-serif !important;
    box-sizing: border-box;
  }

  .ew-grid-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ew-grid-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* توحيد البطاقات */
  .ew-grid-card-full, .ew-grid-card {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 24px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
  }

  .ew-grid-card-full:hover, .ew-grid-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px -8px rgba(0, 0, 0, 0.08);
  }

  /* البطاقة العريضة العلوية */
  .ew-grid-card-full {
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-between;
    padding: 40px;
    min-height: 280px;
  }

  /* توزيع الصفوف */
  .ew-grid-row-2, .ew-grid-row-3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .ew-grid-card {
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-between;
    padding: 35px;
  }

  /* محتوى النص */
  .ew-card-content {
    max-width: 55%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    height: 100%;
  }
  
  .ew-grid-card-full .ew-card-content {
    max-width: 50%;
  }

  .ew-card-badge {
    display: inline-block;
    background-color: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .ew-card-title {
    font-size: 24px;
    font-weight: 800;
    color: {{ section.settings.text_color }};
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .ew-card-desc {
    font-size: 15px;
    color: {{ section.settings.desc_color }};
    margin: 0 0 20px 0;
    line-height: 1.6;
  }

  /* الأزرار الموحدة */
  .ew-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }} !important;
    padding: 10px 22px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    margin-top: 15px;
  }
  
  .ew-card-btn:hover {
    opacity: 0.95;
    transform: scale(1.02);
  }

  /* الصور الموحدة */
  .ew-card-img-wrapper {
    max-width: 45%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .ew-card-img-wrapper img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* الصف الثالث */
  .ew-row-3-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .ew-row-3-left .ew-grid-card {
    height: 100%;
  }

  /* تحسينات الهواتف والشاشات الصغيرة */
  @media (max-width: 768px) {
    .ew-grid-card-full, .ew-grid-card {
      flex-direction: column !important; /* ترتيب عمودي طبيعي من الأعلى للأسفل */
      padding: 30px 20px;
      text-align: center;
      align-items: center !important;
    }
    
    .ew-card-content {
      max-width: 100% !important;
      align-items: center !important;
      display: flex;
      flex-direction: column;
    }
    
    .ew-grid-row-2, .ew-grid-row-3 {
      grid-template-columns: 1fr;
    }
    
    .ew-card-img-wrapper {
      max-width: 75% !important;
      margin: 20px 0 !important;
      order: 4; /* جعل الصورة تأتي بعد الوصف وقبل الزر */
    }

    .ew-card-badge { order: 1; }
    .ew-card-title { order: 2; font-size: 22px; }
    .ew-card-desc { order: 3; margin-bottom: 0; }
    
    .ew-card-btn {
      width: 100%;
      justify-content: center;
      order: 5; /* إجبار الزر على أن يكون العنصر الأخير في الأسفل دائماً */
      margin-top: 10px;
    }
  }
{%- endstyle -%}

