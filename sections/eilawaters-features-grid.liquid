{%- liquid
  assign is_rtl = false
  if request.locale.iso_code contains 'ar'
    assign is_rtl = true
  endif
-%}

{%- style -%}
  /* استيراد وتطبيق خط Cairo لمنع تداخل الخطوط الافتراضية */
  @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

  .ew-grid-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    direction: rtl;
  }

  .ew-grid-section-{{ section.id }},
  .ew-grid-section-{{ section.id }} * {
    font-family: 'Cairo', sans-serif !important;
    box-sizing: border-box;
  }

  .ew-grid-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ew-grid-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* البطاقات الأساسية المحسنة */
  .ew-grid-card-full, .ew-grid-card {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 24px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ew-grid-card-full:hover, .ew-grid-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px -8px rgba(0, 0, 0, 0.08);
  }

  /* البطاقة العريضة العلوية */
  .ew-grid-card-full {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-between;
    padding: 40px;
    min-height: 280px;
  }

  /* توزيع الجريد للصفوف */
  .ew-grid-row-2, .ew-grid-row-3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .ew-grid-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 35px;
  }

  /* تعديلات هيكلية للبطاقات لتلائم الأزرار */
  .ew-card-tracking {
    flex-direction: row-reverse;
    align-items: center;
  }

  .ew-card-content {
    max-width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
  
  .ew-grid-card-full .ew-card-content {
    max-width: 45%;
  }

  .ew-card-badge {
    display: inline-block;
    background-color: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .ew-card-title {
    font-size: 26px;
    font-weight: 800;
    color: {{ section.settings.text_color }};
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .ew-card-desc {
    font-size: 15px;
    color: {{ section.settings.desc_color }};
    margin: 0 0 20px 0;
    line-height: 1.6;
  }

  /* أزرار مرنة واحترافية */
  .ew-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }} !important;
    padding: 10px 22px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    margin-top: auto;
  }
  .ew-card-btn:hover {
    opacity: 0.95;
    transform: scale(1.02);
  }

  /* معالجة وتوسيط الصور */
  .ew-card-img-wrapper {
    max-width: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .ew-card-img-wrapper img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* الصف الثالث والبطاقات الصغيرة */
  .ew-row-3-left {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    gap: 24px;
  }
  .ew-card-mini {
    flex-direction: row-reverse;
    align-items: center;
    padding: 25px 30px;
  }
  .ew-card-mini .ew-card-content {
    max-width: 60%;
  }
  .ew-card-mini .ew-card-img-wrapper {
    max-width: 35%;
  }
  .ew-card-mini .ew-card-title {
    font-size: 20px;
    margin-bottom: 8px;
  }

  /* التوافق التام الذكي مع الهواتف والشاشات الصغيرة */
  @media (max-width: 768px) {
    .ew-grid-card-full, .ew-card-tracking, .ew-card-mini {
      flex-direction: column-reverse !important;
      padding: 25px 20px;
      text-align: center;
    }
    .ew-grid-card-full .ew-card-content, .ew-card-content, .ew-card-mini .ew-card-content {
      max-width: 100% !important;
      align-items: center !important;
    }
    .ew-grid-row-2, .ew-grid-row-3 {
      grid-template-columns: 1fr;
    }
    .ew-card-img-wrapper, .ew-card-mini .ew-card-img-wrapper {
      max-width: 70% !important;
      margin-bottom: 20px;
    }
    .ew-card-title {
      font-size: 22px;
    }
    .ew-card-btn {
      width: 100%;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="ew-grid-section-{{ section.id }}">
  <div class="ew-grid-container">
    <div class="ew-grid-wrapper">
      
      <!-- البطاقة 1: العريضة العلوية -->
      <div class="ew-grid-card-full">
        <div class="ew-card-img-wrapper">
          {% if section.settings.img_1 != blank %}
            <img src="{{ section.settings.img_1 | image_url: width: 600 }}" alt="{{ section.settings.title_1 }}" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ew-card-content">
          <h2 class="ew-card-title">{{ section.settings.title_1 }}</h2>
          <p class="ew-card-desc">{{ section.settings.desc_1 }}</p>
          {% if section.settings.btn_link_1 != blank and section.settings.btn_text_1 != blank %}
            <a href="{{ section.settings.btn_link_1 }}" class="ew-card-btn">
              {{ section.settings.btn_text_1 }}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- الصف الثاني (كرتين متساويين) -->
      <div class="ew-grid-row-2">
        <!-- البطاقة 2: تتبع طلبك -->
        <div class="ew-grid-card ew-card-tracking">
          <div class="ew-card-img-wrapper">
            {% if section.settings.img_2 != blank %}
              <img src="{{ section.settings.img_2 | image_url: width: 500 }}" alt="{{ section.settings.title_2 }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ew-card-content">
            <h2 class="ew-card-title">{{ section.settings.title_2 }}</h2>
            <p class="ew-card-desc">{{ section.settings.desc_2 }}</p>
            {% if section.settings.btn_link_2 != blank and section.settings.btn_text_2 != blank %}
              <a href="{{ section.settings.btn_link_2 }}" class="ew-card-btn">
                {{ section.settings.btn_text_2 }}
              </a>
            {% endif %}
          </div>
        </div>

        <!-- البطاقة 3: نوصل لأي مكان -->
        <div class="ew-grid-card" style="justify-content: space-between; align-items: center; text-align: center;">
          <div class="ew-card-content" style="max-width:100%; align-items: center; margin-bottom:15px;">
            {% if section.settings.badge_3 != blank %}
              <span class="ew-card-badge">{{ section.settings.badge_3 }}</span>
            {% endif %}
            <h2 class="ew-card-title" style="font-size:32px;">{{ section.settings.title_3 }}</h2>
          </div>
          <div class="ew-card-img-wrapper" style="max-width:90%; margin-bottom: 20px;">
            {% if section.settings.img_3 != blank %}
              <img src="{{ section.settings.img_3 | image_url: width: 500 }}" alt="{{ section.settings.title_3 }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          {% if section.settings.btn_link_3 != blank and section.settings.btn_text_3 != blank %}
            <a href="{{ section.settings.btn_link_3 }}" class="ew-card-btn">
              {{ section.settings.btn_text_3 }}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- الصف الثالث (كرت دعم عملاء + كرتين صغيرين على اليسار) -->
      <div class="ew-grid-row-3">
        <!-- البطاقة 4: دعم العملاء 24/7 -->
        <div class="ew-grid-card" style="align-items: center; text-align: center;">
          <div class="ew-card-content" style="max-width:100%; align-items: center;">
            {% if section.settings.badge_4 != blank %}
              <span class="ew-card-badge">{{ section.settings.badge_4 }}</span>
            {% endif %}
            <h2 class="ew-card-title" style="font-size:30px;">{{ section.settings.title_4 }}</h2>
            <p class="ew-card-desc">{{ section.settings.desc_4 }}</p>
          </div>
          <div class="ew-card-img-wrapper" style="max-width:90%; margin-bottom:20px;">
            {% if section.settings.img_4 != blank %}
              <img src="{{ section.settings.img_4 | image_url: width: 500 }}" alt="{{ section.settings.title_4 }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          {% if section.settings.btn_link_4 != blank and section.settings.btn_text_4 != blank %}
            <a href="{{ section.settings.btn_link_4 }}" class="ew-card-btn">
              {{ section.settings.btn_text_4 }}
            </a>
          {% endif %}
        </div>

        <!-- العمود الأيسر (كرتين صغيرين عموديين) -->
        <div class="ew-row-3-left">
          <!-- البطاقة 5: وقت التوصيل -->
          <div class="ew-grid-card ew-card-mini">
            <div class="ew-card-img-wrapper">
              {% if section.settings.img_5 != blank %}
                <img src="{{ section.settings.img_5 | image_url: width: 200 }}" alt="{{ section.settings.title_5 }}" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ew-card-content">
              <h2 class="ew-card-title">{{ section.settings.title_5 }}</h2>
              {% if section.settings.btn_link_5 != blank and section.settings.btn_text_5 != blank %}
                <a href="{{ section.settings.btn_link_5 }}" class="ew-card-btn">
                  {{ section.settings.btn_text_5 }}
                </a>
              {% endif %}
            </div>
          </div>

          <!-- البطاقة 6: خيارات الدفع -->
          <div class="ew-grid-card ew-card-mini">
            <div class="ew-card-img-wrapper">
              {% if section.settings.img_6 != blank %}
                <img src="{{ section.settings.img_6 | image_url: width: 200 }}" alt="{{ section.settings.title_6 }}" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ew-card-content">
              <h2 class="ew-card-title">{{ section.settings.title_6 }}</h2>
              {% if section.settings.btn_link_6 != blank and section.settings.btn_text_6 != blank %}
                <a href="{{ section.settings.btn_link_6 }}" class="ew-card-btn">
                  {{ section.settings.btn_text_6 }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

