{%- schema -%}
{
  "name": "بانر آبار المطور v6",
  "settings": [
    { "type": "image_picker", "id": "bg_image_desktop", "label": "خلفية الكمبيوتر" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "خلفية الهاتف" },
    { "type": "text", "id": "parent_pre_title", "label": "العنوان العلوي", "default": "آيلا للمياه" },
    { "type": "text", "id": "parent_button_text", "label": "نص الزر", "default": "تسوق الآن" },
    { "type": "url", "id": "parent_button_link", "label": "رابط الزر" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "شريحة",
      "settings": [
        { "type": "textarea", "id": "slide_title", "label": "العنوان الرئيسي" },
        { "type": "image_picker", "id": "image_right", "label": "الصورة اليمنى" },
        { "type": "image_picker", "id": "image_left", "label": "الصورة اليسرى" }
      ]
    }
  ],
  "presets": [{ "name": "بانر آبار المطور v6", "blocks": [{ "type": "slide" }] }]
}
{%- endschema -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

{%- style -%}
.hero-canvas-section { position: relative; width: 100%; min-height: 590px; overflow: hidden; }
.swiper-slide { display: flex; align-items: center; justify-content: center; position: relative; }
.hero-center { width: 100%; max-width: 700px; text-align: center; z-index: 10; }
.hero-wing { position: absolute; bottom: 0; z-index: 5; pointer-events: none; opacity: 0; transition: all 0.8s ease-out; }
.hero-wing--left { left: -150px; }
.hero-wing--right { right: -150px; }

/* تفعيل الحركة عند نشاط الشريحة */
.swiper-slide-active .hero-wing--left { left: 0; opacity: 1; }
.swiper-slide-active .hero-wing--right { right: 0; opacity: 1; }

@media (max-width: 767px) { .hero-wing { width: 40%; } }
{%- endstyle -%}

<section class="hero-canvas-section swiper">
  <div class="swiper-wrapper">
    {%- for block in section.blocks -%}
      <div class="swiper-slide">
        <div class="hero-wing hero-wing--left">
          {%- if block.settings.image_left != blank -%}<img src="{{ block.settings.image_left | image_url: width: 600 }}" loading="lazy">{%- endif -%}
        </div>

        <div class="hero-center">
          <h1 class="hero-title">{{ block.settings.slide_title }}</h1>
          <a href="{{ section.settings.parent_button_link }}" class="hero-btn">{{ section.settings.parent_button_text }}</a>
        </div>

        <div class="hero-wing hero-wing--right">
          {%- if block.settings.image_right != blank -%}<img src="{{ block.settings.image_right | image_url: width: 600 }}" loading="lazy">{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  new Swiper('.hero-canvas-section', {
    loop: true,
    autoplay: { delay: 5000 },
    effect: 'fade'
  });
</script>