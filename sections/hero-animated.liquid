{%- style -%}
.hero-canvas-section {
  position: relative; width: 100%; display: flex; align-items: center; justify-content: center;
  overflow: hidden; background-size: cover; background-position: center; direction: rtl;
  background-image: var(--hero-bg-desktop, none); padding: 100px 0; min-height: 500px;
}
.hero-canvas-container { position: relative; width: 100%; max-width: 1200px; display: flex; align-items: center; justify-content: center; }

/* إصلاح التموضع: الصور تكون في الخلفية أو الأطراف */
.hero-canvas-wing { position: absolute; bottom: 0; width: 35%; height: auto; z-index: 1; pointer-events: none; }
.hero-canvas-wing--left { left: 0; }
.hero-canvas-wing--right { right: 0; }
.hero-canvas-img-box { width: 100%; max-width: 450px; }
.hero-canvas-img-box img { width: 100%; height: auto; }

/* إصلاح النص والزر: ليكون فوق الصور */
.hero-canvas-center { position: relative; z-index: 10; text-align: center; padding: 20px; }
.hero-canvas-title { font-size: clamp(1.5rem, 3.5vw, 2.8rem); font-weight: 800; color: #1e293b; margin-bottom: 20px; }
.hero-canvas-btn { 
  display: inline-block; padding: 15px 40px; background: #0f172a; color: #fff; 
  text-decoration: none; border-radius: 50px; font-weight: 700; transition: 0.3s;
}
.hero-canvas-btn:hover { background: #0284c7; }

@media (max-width: 767px) {
  .hero-canvas-section { padding-top: 50px; }
  .hero-canvas-wing { width: 50%; }
  .hero-canvas-wing--left .hero-canvas-img-box { max-width: 180px; }
  .hero-canvas-wing--right .hero-canvas-img-box { max-width: 180px; }
  .hero-canvas-title { font-size: 1.5rem; }
}
{%- endstyle -%}

<section class="hero-canvas-section" style="--hero-bg-desktop: url('{{ section.settings.bg_image_desktop | image_url: width: 2000 }}'); --hero-bg-mobile: url('{{ section.settings.bg_image_mobile | image_url: width: 800 }}');">
  <div class="hero-canvas-container">
    {%- for block in section.blocks -%}
      <div class="hero-canvas-slide {% if forloop.first %}is-active{% endif %}" style="width: 100%; display: {% if forloop.first %}flex{% else %}none{% endif %}; align-items: center; justify-content: center;">
        
        <div class="hero-canvas-wing hero-canvas-wing--left">
          {%- if block.settings.image_left != blank -%}
            <div class="hero-canvas-img-box"><img src="{{ block.settings.image_left | image_url: width: 600 }}" alt="Left"></div>
          {%- endif -%}
        </div>

        <div class="hero-canvas-center">
          <span class="hero-canvas-pre-title">{{ section.settings.parent_pre_title }}</span>
          <h1 class="hero-canvas-title">{{ block.settings.slide_title | newline_to_br }}</h1>
          <a href="{{ section.settings.parent_button_link }}" class="hero-canvas-btn">{{ section.settings.parent_button_text }}</a>
        </div>

        <div class="hero-canvas-wing hero-canvas-wing--right">
          {%- if block.settings.image_right != blank -%}
            <div class="hero-canvas-img-box"><img src="{{ block.settings.image_right | image_url: width: 600 }}" alt="Right"></div>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>
</section>