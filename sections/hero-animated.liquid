{% comment %}
  Professional Animated Hero Slider - Tailored for 3000x1378 Aspect Ratio & Strict RTL Mobile Layout
{% endcomment %}

{%- schema -%}
{
  "name": "بانر آبار المطور",
  "settings": [
    {
      "type": "header",
      "content": "الخلفية العامة"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "صورة الخلفية الثابتة"
    },
    {
      "type": "checkbox",
      "id": "overlay_dark",
      "label": "تفعيل تعتيم الخلفية (لزيادة وضوح النص)",
      "default": false
    },
    {
      "type": "header",
      "content": "العناصر الثابتة (الأب)"
    },
    {
      "type": "text",
      "id": "parent_pre_title",
      "label": "اسم المتجر الثابت",
      "default": "آيلا للمياه"
    },
    {
      "type": "text",
      "id": "parent_button_text",
      "label": "نص الزر الثابت",
      "default": "تسوق الآن"
    },
    {
      "type": "url",
      "id": "parent_button_link",
      "label": "رابط الزر الثابت",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "شريحة بانر (ابن)",
      "settings": [
        {
          "type": "textarea",
          "id": "slide_title",
          "label": "العنوان الرئيسي المتغير",
          "default": "نصلك بأسرع وقت ونوفر عليك عناء البحث وتعب التوصيل."
        },
        {
          "type": "image_picker",
          "id": "image_right",
          "label": "الصورة اليمنى (PNG)"
        },
        {
          "type": "image_picker",
          "id": "image_left",
          "label": "الصورة اليسرى (PNG)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "بانر آبار المطور",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{%- endschema -%}

{%- style -%}
/* محاكاة وتثبيت أبعاد اللوحة الخلفية الأصلية */
.hero-canvas-section {
  position: relative;
  width: 100%;
  min-height: 75vh;
  aspect-ratio: 3000 / 1378; /* الحفاظ التام على أبعاد صورتك وتجنب قطعها */
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  direction: rtl; /* دعم لغة الضاد افتراضياً */
}

.hero-canvas-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.25);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
}
.hero-canvas-section[data-overlay="true"]::before {
  opacity: 1;
}

/* حاوية العرض الكلية المتجاوبة */
.hero-canvas-container {
  position: relative;
  width: 100%;
  height: 100%;
  max-width: 100%;
  padding: 0 2%;
  z-index: 5;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-canvas-slider {
  position: relative;
  width: 100%;
}

/* الشريحة الابن: تقسيم اللوحة أفقياً إلى 3 أجزاء متناسقة تدعم التداخل */
.hero-canvas-slide {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s ease, visibility 0.5s ease;
  z-index: 3;
}

.hero-canvas-slide.is-active {
  position: relative;
  opacity: 1;
  visibility: visible;
  z-index: 4;
}

/* الأجزاء الجانبية (اليمين واليسار) - مجهزة لعدم الانضغاط وتكبير الحجم */
.hero-canvas-wing {
  flex: 0 0 28%; /* تخصيص قرابة ثلث المساحة لكل جانب بالتساوي */
  max-width: 28%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 4;
}

.hero-canvas-wing--right {
  order: 3; /* يظهر يميناً في الـ RTL */
}

.hero-canvas-wing--left {
  order: 1; /* يظهر يساراً في الـ RTL */
}

.hero-canvas-img-box {
  width: 100%;
  filter: drop-shadow(0 20px 35px rgba(0,0,0,0.15));
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-canvas-img-box img {
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}

/* الجزء الأوسط (كتلة المحتوى الموحد الشامل للنصوص والزر) */
.hero-canvas-center {
  flex: 0 0 44%;
  max-width: 44%;
  order: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 5;
  padding: 0 10px;
}

/* تصحيح تموضع اسم المتجر الثابت ليكون في قلب التراتبية */
.hero-canvas-pre-title {
  font-family: 'Cairo', sans-serif;
  font-size: clamp(1.1rem, 2vw, 1.6rem);
  font-weight: 700;
  color: #0284c7;
  margin-bottom: 12px;
}
.hero-canvas-section[data-overlay="true"] .hero-canvas-pre-title {
  color: #38bdf8;
}

/* العنوان الرئيسي الكبير المتغير */
.hero-canvas-title {
  font-family: 'Cairo', sans-serif;
  font-size: clamp(1.4rem, 3.5vw, 2.8rem);
  font-weight: 800;
  line-height: 1.35;
  color: #1e293b;
  margin: 0 0 20px 0;
  transform: scale(0.95);
  opacity: 0;
  transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}
.hero-canvas-section[data-overlay="true"] .hero-canvas-title {
  color: #ffffff;
}

/* زر الإجراء الثابت المتواجد في نهاية التراتبية النصية */
.hero-canvas-btn-holder {
  margin-top: 5px;
}
.hero-canvas-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.8rem 2.5rem;
  font-family: 'Cairo', sans-serif;
  font-weight: 700;
  font-size: clamp(0.9rem, 1.5vw, 1.1rem);
  color: #ffffff;
  background-color: #0f172a;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}
.hero-canvas-btn:hover {
  background-color: #0284c7;
  transform: translateY(-2px);
}

/* تفعيل حركات الدخول الانسيابية عند النشاط */
.hero-canvas-slide.is-active .hero-canvas-title {
  transform: scale(1);
  opacity: 1;
}

.hero-canvas-slide.is-active .hero-canvas-wing--left .hero-canvas-img-box {
  opacity: 1;
  animation: slideInLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-canvas-slide.is-active .hero-canvas-wing--right .hero-canvas-img-box {
  opacity: 1;
  animation: slideInRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideInLeft {
  0% { opacity: 0; transform: translateX(-80px) scale(0.9); }
  100% { opacity: 1; transform: translateX(0) scale(1); }
}

@keyframes slideInRight {
  0% { opacity: 0; transform: translateX(80px) scale(0.9); }
  100% { opacity: 1; transform: translateX(0) scale(1); }
}

/* التحكم بالنقاط (Dots) */
.hero-canvas-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin-top: 25px;
}

.hero-canvas-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(30, 41, 59, 0.2);
  border: none;
  cursor: pointer;
  padding: 0;
  transition: all 0.3s ease;
}
.hero-canvas-section[data-overlay="true"] .hero-canvas-dot {
  background: rgba(255, 255, 255, 0.3);
}

.hero-canvas-dot.is-active {
  background: #0284c7;
  width: 24px;
  border-radius: 6px;
}

/* ==========================================================================
   حل مشكلة الهواتف العويصة: الحفاظ الصارم على البنية الأفقية (اليسار يسار واليمين يمين)
   ========================================================================== */
@media (max-width: 767px) {
  .hero-canvas-section {
    aspect-ratio: auto;
    min-height: 60vh; /* التخلي عن الأبعاد الثابتة على الموبايل لمنع صغر المحتوى */
    padding: 40px 0;
  }
  
  .hero-canvas-slide {
    display: flex !important;
    flex-direction: row !important; /* إجبار التوزيع الأفقي ومنع النزول أسفل بعض */
    align-items: center;
    justify-content: space-between;
  }

  .hero-canvas-wing {
    flex: 0 0 25% !important; /* تقليص الأجنحة قليلاً لمنح الموبايل مساحة نصية */
    max-width: 25% !important;
  }

  .hero-canvas-center {
    flex: 0 0 50% !important;
    max-width: 50% !important;
    padding: 0 5px;
  }
  
  .hero-canvas-dots {
    margin-top: 15px;
  }
}
{%- endstyle -%}

<section class="hero-canvas-section" 
         data-overlay="{{ section.settings.overlay_dark }}"
         style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 3000 }}');{% endif %}">

  <div class="hero-canvas-container">
    <div class="hero-canvas-slider">
      
      {%- for block in section.blocks -%}
        <div class="hero-canvas-slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          
          <!-- الجناح الأيسر للوحة (صورة اليسار الثابتة مكانها دائماً) -->
          <div class="hero-canvas-wing hero-canvas-wing--left">
            {%- if block.settings.image_left != blank -%}
              <div class="hero-canvas-img-box">
                <img src="{{ block.settings.image_left | image_url: width: 700 }}" alt="صورة اليسار" loading="lazy">
              </div>
            {%- endif -%}
          </div>

          <!-- قلب المحتوى (التراتبية الرأسية الصحيحة والنصوص الفوقية) -->
          <div class="hero-canvas-center">
            <!-- 1. اسم المتجر الثابت فوق -->
            {%- if section.settings.parent_pre_title != blank -%}
              <span class="hero-canvas-pre-title">{{ section.settings.parent_pre_title }}</span>
            {%- endif -%}

            <!-- 2. العنوان الكبير المتغير للابن -->
            {%- if block.settings.slide_title != blank -%}
              <h1 class="hero-canvas-title">{{ block.settings.slide_title | newline_to_br }}</h1>
            {%- endif -%}

            <!-- 3. زر الإجراء الثابت تحت -->
            {%- if section.settings.parent_button_text != blank and section.settings.parent_button_link != blank -%}
              <div class="hero-canvas-btn-holder">
                <a href="{{ section.settings.parent_button_link }}" class="hero-canvas-btn">{{ section.settings.parent_button_text }}</a>
              </div>
            {%- endif -%}
          </div>

          <!-- الجناح الأيمن للوحة (صورة اليمين الثابتة مكانها دائماً) -->
          <div class="hero-canvas-wing hero-canvas-wing--right">
            {%- if block.settings.image_right != blank -%}
              <div class="hero-canvas-img-box">
                <img src="{{ block.settings.image_right | image_url: width: 700 }}" alt="صورة اليمين" loading="lazy">
              </div>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}

    </div>

    <!-- نقاط التحكم السفلية (Dots) -->
    {%- if section.blocks.size > 1 -%}
      <div class="hero-canvas-dots">
        {%- for block in section.blocks -%}
          <button class="hero-canvas-dot {% if forloop.first %}is-active{% endif %}" data-slide-to="{{ forloop.index0 }}" aria-label="الشريحة {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.querySelector('.hero-canvas-section');
    if (!section) return;

    const slides = section.querySelectorAll('.hero-canvas-slide');
    const dots = section.querySelectorAll('.hero-canvas-dot');
    let currentSlide = 0;
    const totalSlides = slides.length;

    function changeSlide(index) {
      slides[currentSlide].classList.remove('is-active');
      dots[currentSlide].classList.remove('is-active');
      
      currentSlide = index;
      
      slides[currentSlide].classList.add('is-active');
      dots[currentSlide].classList.add('is-active');
    }

    dots.forEach(dot => {
      dot.addEventListener('click', function() {
        const target = parseInt(this.getAttribute('data-slide-to'));
        changeSlide(target);
      });
    });

    if (totalSlides > 1) {
      setInterval(() => {
        let next = (currentSlide + 1) % totalSlides;
        changeSlide(next);
      }, 5000);
    }
  });
</script>