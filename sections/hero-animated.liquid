{% comment %}
  Advanced Animated Hero Slider - Fixed Transparent Header Overlap & Dual Backgrounds
{% endcomment %}

{%- schema -%}
{
  "name": "بانر آبار المطور v3",
  "settings": [
    {
      "type": "header",
      "content": "الخلفيات المخصصة"
    },
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "صورة خلفية الكمبيوتر"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "صورة خلفية الهاتف"
    },
    {
      "type": "checkbox",
      "id": "overlay_dark",
      "label": "تفعيل تعتيم الخلفية (لزيادة وضوح النص)",
      "default": false
    },
    {
      "type": "header",
      "content": "العناصر الثابتة (الأب)"
    },
    {
      "type": "text",
      "id": "parent_pre_title",
      "label": "اسم المتجر الثابت",
      "default": "آيلا للمياه"
    },
    {
      "type": "text",
      "id": "parent_button_text",
      "label": "نص الزر الثابت",
      "default": "تسوق الآن"
    },
    {
      "type": "url",
      "id": "parent_button_link",
      "label": "رابط الزر الثابت",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "شريحة بانر (ابن)",
      "settings": [
        {
          "type": "textarea",
          "id": "slide_title",
          "label": "العنوان الرئيسي المتغير",
          "default": "نصلك بأسرع وقت ونوفر عليك عناء البحث وتعب التوصيل."
        },
        {
          "type": "image_picker",
          "id": "image_right",
          "label": "الصورة اليمنى (PNG)"
        },
        {
          "type": "image_picker",
          "id": "image_left",
          "label": "الصورة اليسرى (PNG)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "بانر آبار المطور v3",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{%- endschema -%}

{%- style -%}
.hero-canvas-section {
  position: relative;
  width: 100%;
  min-height: 85vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  direction: rtl;
  background-image: var(--hero-bg-desktop, none);
  
  /* حل مشكلة الهيدر الشفاف: دفع محتوى البانر لأسفل لحماية اسم المتجر من الاختفاء */
  padding-top: 140px; 
  padding-bottom: 60px;
}

/* طبقة التعتيم لحماية النصوص */
.hero-canvas-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.25);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
}
.hero-canvas-section[data-overlay="true"]::before {
  opacity: 1;
}

.hero-canvas-container {
  position: relative;
  width: 100%;
  max-width: 100%;
  height: 100%;
  z-index: 5;
}

.hero-canvas-slider {
  position: relative;
  width: 100%;
  min-height: 480px;
}

.hero-canvas-slide {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s ease, visibility 0.5s ease;
  z-index: 3;
}

.hero-canvas-slide.is-active {
  position: relative;
  opacity: 1;
  visibility: visible;
  z-index: 4;
}

/* قلب المحتوى النصي الموحد - يظهر بوضوح فوق الأجنحة والصور */
.hero-canvas-center {
  position: relative;
  width: 100%;
  max-width: 700px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20; /* رفع طبقة النص ليكون دائماً في الأعلى والواجهة */
  padding: 0 20px;
  pointer-events: auto;
}

/* إظهار اسم المتجر الثابت بشكل ممتاز وجذاب */
.hero-canvas-pre-title {
  display: block;
  font-family: 'Cairo', sans-serif;
  font-size: clamp(1.2rem, 2.2vw, 1.6rem);
  font-weight: 700;
  color: #0284c7; /* لون أزرق آبار المتناسق */
  margin-bottom: 15px;
  letter-spacing: 0.5px;
  z-index: 25;
}
.hero-canvas-section[data-overlay="true"] .hero-canvas-pre-title {
  color: #38bdf8;
}

.hero-canvas-title {
  font-family: 'Cairo', sans-serif;
  font-size: clamp(1.6rem, 3.8vw, 3rem);
  font-weight: 800;
  line-height: 1.4;
  color: #1e293b;
  margin: 0 0 25px 0;
  transform: translateY(20px);
  opacity: 0;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.hero-canvas-section[data-overlay="true"] .hero-canvas-title {
  color: #ffffff;
}

.hero-canvas-btn-holder {
  margin-top: 5px;
}
.hero-canvas-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.9rem 3.2rem;
  font-family: 'Cairo', sans-serif;
  font-weight: 700;
  font-size: clamp(1rem, 1.6vw, 1.15rem);
  color: #ffffff;
  background-color: #0f172a;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}
.hero-canvas-btn:hover {
  background-color: #0284c7;
  transform: translateY(-3px);
}

/* أجنحة الصور الجانبية الممتدة خلف النصوص وبدون فراغات */
.hero-canvas-wing {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 35%; 
  height: auto;
  max-height: 95%;
  display: flex;
  align-items: center;
  z-index: 5; /* طبقة تحت النصوص لتداخل فاخر */
  pointer-events: none; 
}

.hero-canvas-wing--left {
  left: 0;
  justify-content: flex-start;
}

.hero-canvas-wing--right {
  right: 0;
  justify-content: flex-end;
}

.hero-canvas-img-box {
  width: 100%;
  max-width: 420px; 
  filter: drop-shadow(0 15px 30px rgba(0,0,0,0.1));
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-canvas-img-box img {
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}

/* حركة ظهور الشريحة النشطة */
.hero-canvas-slide.is-active .hero-canvas-title {
  transform: translateY(0);
  opacity: 1;
}

.hero-canvas-slide.is-active .hero-canvas-wing--left .hero-canvas-img-box {
  opacity: 1;
  animation: slideInLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.hero-canvas-slide.is-active .hero-canvas-wing--right .hero-canvas-img-box {
  opacity: 1;
  animation: slideInRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideInLeft {
  0% { opacity: 0; transform: translateX(-60px) scale(0.95); }
  100% { opacity: 1; transform: translateX(0) scale(1); }
}

@keyframes slideInRight {
  0% { opacity: 0; transform: translateX(60px) scale(0.95); }
  100% { opacity: 1; transform: translateX(0) scale(1); }
}

/* نقاط التحكم السفلية */
.hero-canvas-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin-top: 30px;
  position: relative;
  z-index: 30;
}

.hero-canvas-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(30, 41, 59, 0.2);
  border: none;
  cursor: pointer;
  padding: 0;
  transition: all 0.3s ease;
}
.hero-canvas-section[data-overlay="true"] .hero-canvas-dot {
  background: rgba(255, 255, 255, 0.3);
}

.hero-canvas-dot.is-active {
  background: #0284c7;
  width: 24px;
  border-radius: 6px;
}

/* ==========================================================================
   تعديلات الجوال والشاشات الصغيرة (تأمين تباعد الهيدر الشفاف والأفقي الصارم)
   ========================================================================== */
@media (max-width: 767px) {
  .hero-canvas-section {
    background-image: var(--hero-bg-mobile, var(--hero-bg-desktop, none));
    min-height: 70vh;
    padding-top: 110px; /* تباعد آمن ومناسب لحجم هيدر الجوال الشفاف */
    padding-bottom: 40px;
  }

  .hero-canvas-slider {
    min-height: 400px;
  }

  /* تداخل كامل وعريض بدون أي فراغات أفقية خلف النصوص */
  .hero-canvas-wing {
    width: 45%; 
    max-height: 85%;
  }

  .hero-canvas-img-box {
    max-width: 200px; 
  }

  .hero-canvas-center {
    max-width: 95%;
    padding: 0 5px;
  }
}
{%- endstyle -%}

<section class="hero-canvas-section" 
         data-overlay="{{ section.settings.overlay_dark }}"
         style="{% if section.settings.bg_image_desktop != blank %}--hero-bg-desktop: url('{{ section.settings.bg_image_desktop | image_url: width: 3000 }}');{% endif %}
                {% if section.settings.bg_image_mobile != blank %}--hero-bg-mobile: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');{% endif %}">

  <div class="hero-canvas-container">
    <div class="hero-canvas-slider">
      
      {%- for block in section.blocks -%}
        <div class="hero-canvas-slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          
          <!-- الجناح الأيسر -->
          <div class="hero-canvas-wing hero-canvas-wing--left">
            {%- if block.settings.image_left != blank -%}
              <div class="hero-canvas-img-box">
                <img src="{{ block.settings.image_left | image_url: width: 800 }}" alt="صورة اليسار" loading="lazy">
              </div>
            {%- endif -%}
          </div>

          <!-- الصندوق النصي الموحد المحمي من التداخل العلوي -->
          <div class="hero-canvas-center">
            <!-- 1. اسم المتجر الثابت (يظهر الآن في مكانه الصحيح تماماً) -->
            {%- if section.settings.parent_pre_title != blank -%}
              <span class="hero-canvas-pre-title">{{ section.settings.parent_pre_title }}</span>
            {%- endif -%}

            <!-- 2. العنوان الرئيسي المتغير للشريحة -->
            {%- if block.settings.slide_title != blank -%}
              <h1 class="hero-canvas-title">{{ block.settings.slide_title | newline_to_br }}</h1>
            {%- endif -%}

            <!-- 3. زر الإجراء الثابت تحت -->
            {%- if section.settings.parent_button_text != blank and section.settings.parent_button_link != blank -%}
              <div class="hero-canvas-btn-holder">
                <a href="{{ section.settings.parent_button_link }}" class="hero-canvas-btn">{{ section.settings.parent_button_text }}</a>
              </div>
            {%- endif -%}
          </div>

          <!-- الجناح الأيمن -->
          <div class="hero-canvas-wing hero-canvas-wing--right">
            {%- if block.settings.image_right != blank -%}
              <div class="hero-canvas-img-box">
                <img src="{{ block.settings.image_right | image_url: width: 800 }}" alt="صورة اليمين" loading="lazy">
              </div>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}

    </div>

    <!-- نقاط التحكم السفلية المتجاوبة (Dots) -->
    {%- if section.blocks.size > 1 -%}
      <div class="hero-canvas-dots">
        {%- for block in section.blocks -%}
          <button class="hero-canvas-dot {% if forloop.first %}is-active{% endif %}" data-slide-to="{{ forloop.index0 }}" aria-label="شريحة {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.querySelector('.hero-canvas-section');
    if (!section) return;

    const slides = section.querySelectorAll('.hero-canvas-slide');
    const dots = section.querySelectorAll('.hero-canvas-dot');
    let currentSlide = 0;
    const totalSlides = slides.length;

    function changeSlide(index) {
      slides[currentSlide].classList.remove('is-active');
      dots[currentSlide].classList.remove('is-active');
      
      currentSlide = index;
      
      slides[currentSlide].classList.add('is-active');
      dots[currentSlide].classList.add('is-active');
    }

    dots.forEach(dot => {
      dot.addEventListener('click', function() {
        const target = parseInt(this.getAttribute('data-slide-to'));
        changeSlide(target);
      });
    });

    if (totalSlides > 1) {
      setInterval(() => {
        let next = (currentSlide + 1) % totalSlides;
        changeSlide(next);
      }, 5000);
    }
  });
</script>