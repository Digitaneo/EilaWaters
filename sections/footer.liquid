{%- style -%}
  /* معرفات فريدة لمنع التداخل مع القالب الجاهز */
  .ew-footer-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    direction: rtl; /* اتجاه عربي بالكامل */
    font-family: inherit;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .ew-footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* شبكة توزيع الفوتر الأساسية */
  .ew-footer-main-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin-bottom: 40px;
    justify-content: space-between;
  }

  .ew-footer-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1 1 200px;
  }

  .ew-footer-logo-col {
    flex: 1.5 1 280px;
  }

  .ew-footer-contact-col {
    flex: 2 1 300px;
  }

  /* الشعار واسم المتجر */
  .ew-footer-logo-area img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
    margin-bottom: 10px;
  }
  .ew-footer-store-name {
    font-size: 22px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin: 0;
  }
  
  .ew-footer-firm-name {
    font-size: 13px;
    color: {{ section.settings.muted_text_color }};
    line-height: 1.4;
    margin-bottom: 10px;
  }

  /* التنسيق الجديد والمحسن للتوثيقات الرسمية تحت الشعار مباشرة */
  .ew-footer-legal-docs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
  }
  .ew-footer-legal-doc-item {
    display: flex;
    align-items: center; /* محاذاة عمودية في المنتصف للصور والنصوص */
    gap: 8px; /* المسافة بين الصورة والنص */
    font-size: 13px;
    color: {{ section.settings.text_color }};
  }
  
  /* إجبار الصور الجانبية المضافة على الظهور بحجم صغير جداً ومنسق يميناً */
  .ew-footer-legal-doc-item img {
    width: 24px !important; 
    height: 24px !important;
    object-fit: contain;
    flex-shrink: 0; /* منع الصورة من الانضغاط أو التشوه */
    display: block;
  }

  /* العناوين الفرعية للأعمدة والقوائم */
  .ew-footer-col-title {
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0 0 8px 0;
  }

  /* قوائم الروابط */
  .ew-footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ew-footer-links-list a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 15px;
    transition: color 0.3s ease;
  }
  .ew-footer-links-list a:hover {
    color: {{ section.settings.accent_color }};
    padding-right: 4px;
  }

  /* معلومات التواصل */
  .ew-footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.6;
  }
  .ew-footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .ew-footer-contact-item a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }
  .ew-footer-contact-item a:hover {
    color: {{ section.settings.accent_color }};
  }

  /* الخريطة المصغرة */
  .ew-footer-map-wrapper {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid {{ section.settings.border_color }};
    height: 120px;
    width: 100%;
    margin-top: 5px;
  }
  .ew-footer-map-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* مربع الاشتراك في البريد الإلكتروني */
  .ew-footer-newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ew-footer-input-group {
    display: flex;
    position: relative;
    width: 100%;
  }
  .ew-footer-newsletter-input {
    width: 100%;
    padding: 14px 16px;
    padding-left: 120px;
    background-color: {{ section.settings.input_bg_color }};
    border: 1px solid {{ section.settings.input_border_color }};
    border-radius: 30px;
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
    outline: none;
    box-sizing: border-box;
  }
  .ew-footer-newsletter-input:focus {
    border-color: {{ section.settings.accent_color }};
  }
  .ew-footer-newsletter-btn {
    position: absolute;
    left: 4px;
    top: 4px;
    bottom: 4px;
    padding: 0 20px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border: none;
    border-radius: 26px;
    cursor: pointer;
    font-family: inherit;
    font-weight: bold;
    font-size: 14px;
    transition: background-color 0.3s ease;
  }
  .ew-footer-newsletter-btn:hover {
    background-color: {{ section.settings.accent_color }};
    color: #ffffff;
  }

  /* الشريط السفلي للحقوق وأيقونات التواصل */
  .ew-footer-bottom-bar {
    border-top: 1px solid {{ section.settings.border_color }};
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 13px;
    color: {{ section.settings.muted_text_color }};
  }

  /* تنسيق أيقونات التواصل الاجتماعي */
  .ew-footer-social-links {
    display: flex;
    gap: 15px;
    align-items: center;
  }
  .ew-footer-social-icon {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: color 0.3s ease, transform 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .ew-footer-social-icon:hover {
    color: {{ section.settings.accent_color }};
    transform: translateY(-3px);
  }
  .ew-footer-social-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* التجاوب التام للشاشات الصغيرة والهواتف المحمولة */
  @media (max-width: 768px) {
    .ew-footer-main-grid {
      flex-direction: column;
      gap: 35px;
      text-align: center;
    }
    .ew-footer-column {
      align-items: center;
      flex: 1 1 100%;
    }
    .ew-footer-legal-docs {
      align-items: center;
    }
    .ew-footer-contact-item {
      justify-content: center;
    }
    .ew-footer-input-group {
      max-width: 400px;
      margin: 0 auto;
    }
    .ew-footer-bottom-bar {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}

<footer class="ew-footer-section-{{ section.id }}">
  <div class="ew-footer-container">
    
    <!-- الشبكة العلوية الرئيسية للفوتر -->
    <div class="ew-footer-main-grid">
      
      <!-- العمود الأول الثابت: الشعار والمعلومات الرسمية والتراخيص (تحتها مباشرة) -->
      <div class="ew-footer-column ew-footer-logo-col">
        <div class="ew-footer-logo-area">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ section.settings.store_name }}" loading="lazy">
          {% else %}
            <h2 class="ew-footer-store-name">{{ section.settings.store_name }}</h2>
          {% endif %}
          <p class="ew-footer-firm-name">{{ section.settings.firm_name }}</p>
        </div>

        <!-- قسم التوثيقات الرسمية بعد الشعار والاسم القانوني مباشرة (الصور تظهر بالجانب الأيمن للنص) -->
        <div class="ew-footer-legal-docs">
          {% if section.settings.tax_number != blank %}
            <div class="ew-footer-legal-doc-item">
              {% if section.settings.tax_image != blank %}
                <img src="{{ section.settings.tax_image | image_url: width: 50 }}" alt="الرقم الضريبي" loading="lazy">
              {% endif %}
              <span>الرقم الضريبي: <strong>{{ section.settings.tax_number }}</strong></span>
            </div>
          {% endif %}

          {% if section.settings.cr_number != blank %}
            <div class="ew-footer-legal-doc-item">
              {% if section.settings.cr_image != blank %}
                <img src="{{ section.settings.cr_image | image_url: width: 50 }}" alt="السجل التجاري" loading="lazy">
              {% endif %}
              <span>السجل التجاري: <strong>{{ section.settings.cr_number }}</strong></span>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- الأعمدة الديناميكية: القوائم والروابط -->
      {% for block in section.blocks %}
        {% if block.type == 'link_list' %}
          <div class="ew-footer-column" {{ block.shopify_attributes }}>
            <h3 class="ew-footer-col-title">{{ block.settings.title }}</h3>
            {% if block.settings.menu != blank %}
              <ul class="ew-footer-links-list">
                {% for link in block.settings.menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      <!-- العمود الثابت الأخير: الدعم، العنوان، الخريطة والاشتراك -->
      <div class="ew-footer-column ew-footer-contact-col">
        <h3 class="ew-footer-col-title">{{ section.settings.contact_title }}</h3>
        
        <div class="ew-footer-contact-info">
          <div class="ew-footer-contact-item">
            <span>📍</span>
            <span>{{ section.settings.address }}</span>
          </div>
          <div class="ew-footer-contact-item">
            <span>📞</span>
            <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
          </div>
          <div class="ew-footer-contact-item">
            <span>✉️</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
        </div>

        <!-- الخريطة المصغرة -->
        <div class="ew-footer-map-wrapper">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d111002.58043628461!2d40.97025815!3d30.97587785!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x15f7b88939bfa383%3A0x6b1db94ba055106a!2sArar%20Saudi%20Arabia!5e0!3m2!1sen!2s!4v1710000000000!5m2!1sen!2s" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

        <!-- صندوق الاشتراك البريدي -->
        <div class="ew-footer-newsletter-area" style="margin-top: 10px;">
          {% form 'customer', class: 'ew-footer-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="ew-footer-input-group">
              <input 
                type="email" 
                name="contact[email]" 
                class="ew-footer-newsletter-input" 
                value="{{ form.email }}" 
                placeholder="بريدك الإلكتروني" 
                autocorrect="off" 
                autocapitalize="off" 
                required
              >
              <button type="submit" class="ew-footer-newsletter-btn" name="commit">
                اشترك الآن
              </button>
            </div>
            {% if form.posted_successfully? %}
              <p style="color: #48bb78; font-size: 13px; margin: 5px 0 0 0;">شكرًا لاشتراكك في عروض ايلا للمياه!</p>
            {% endif %}
          {% endform %}
        </div>
      </div>

    </div>

    <!-- شريط الحقوق السفلي مضافاً إليه أيقونات التواصل الاجتماعي الذكية -->
    <div class="ew-footer-bottom-bar">
      <div class="ew-footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} متجر <strong>{{ section.settings.store_name }}</strong>. جميع الحقوق محفوظة.
      </div>
      
      <!-- الأيقونات الاجتماعية تظهر فقط إذا كان بها رابط في لوحة التحكم -->
      <div class="ew-footer-social-links">
        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" class="ew-footer-social-icon" target="_blank" title="انستغرام">
            <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        {% endif %}

        {% if section.settings.social_tiktok != blank %}
          <a href="{{ section.settings.social_tiktok }}" class="ew-footer-social-icon" target="_blank" title="تيك توك">
            <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.05 1.51 4.21 1.13 1.44 2.75 2.42 4.56 2.73V11.2c-1.66-.13-3.22-.76-4.47-1.85-.17-.14-.14-.08-.14.12.01 2.92.01 5.84 0 8.76-.06 1.76-.55 3.51-1.57 4.93-1.69 2.41-4.71 3.73-7.6 3.19-3.01-.52-5.51-3.07-5.96-6.11-.64-3.92 2.01-7.79 5.96-8.5 1.05-.2 2.14-.13 3.16.19v4.25c-1-.34-2.12-.3-3.07.16-.99.46-1.74 1.42-1.97 2.48-.44 1.83.64 3.78 2.44 4.3 1.56.49 3.39-.14 4.23-1.56.34-.55.51-1.19.49-1.83-.02-3.69-.01-7.38-.01-11.07V.02z"/></svg>
          </a>
        {% endif %}

        {% if section.settings.social_snapchat != blank %}
          <a href="{{ section.settings.social_snapchat }}" class="ew-footer-social-icon" target="_blank" title="سناب شات">
            <svg viewBox="0 0 24 24"><path d="M12 .041c-.8 0-1.391.193-1.921.654-.539.469-1.072 1.34-1.581 2.585-.19.465-.373.992-.55 1.566-.465-.125-.921-.194-1.36-.194-1.681 0-2.61 1.03-2.61 2.373 0 .733.284 1.396.868 2.018.349.373.805.696 1.353.957-.04.167-.061.347-.061.542 0 .542.274 1.01.767 1.341a4.9 4.9 0 00-.705.291c-.495.247-.83.565-1.001.954-.15.342-.143.763.023 1.25.197.581.658.986 1.365 1.206.666.207 1.531.258 2.569.15.541.688 1.254 1.233 2.115 1.621.267.121.571.215.908.281.332.654.673 1.439 1.012 2.333.155.408.311.833.465 1.268.167.472.442.844.815 1.097.352.239.789.362 1.291.362s.939-.123 1.291-.362c.373-.253.648-.625.815-1.097.154-.435.31-.86.465-1.268.339-.894.68-1.679 1.012-2.333.337-.066.641-.16.908-.281.861-.388 1.574-.933 2.115-1.621 1.038.108 1.903.057 2.569-.15.707-.22 1.168-.625 1.365-1.206.166-.487.173-.908.023-1.25-.171-.389-.506-.707-1.001-.954a4.9 4.9 0 00-.705-.291c.493-.331.767-.799.767-1.341 0-.195-.021-.375-.061-.542.548-.261 1.004-.584 1.353-.957.584-.622.868-1.285.868-2.018 0-1.343-.929-2.373-2.61-2.373-.439 0-.895.069-1.36.194-.177-.574-.36-1.101-.55-1.566-.509-1.245-1.042-2.116-1.581-2.585C13.391.234 12.8 0 12 0v.041z"/></svg>
          </a>
        {% endif %}

        {% if section.settings.social_x != blank %}
          <a href="{{ section.settings.social_x }}" class="ew-footer-social-icon" target="_blank" title="منصة X">
            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Eilawaters Pro Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "بيانات المتجر الأساسية"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "اسم المتجر الإلكتروني",
      "default": "ايلا للمياة"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "شعار المتجر (Logo)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "عرض الشعار المخصص",
      "default": 120
    },
    {
      "type": "textarea",
      "id": "firm_name",
      "label": "الاسم القانوني / الكيان للمؤسسة",
      "default": "مكتب أيلا يحي احمد ابوعله للخدمات الالكترونية"
    },
    {
      "type": "header",
      "content": "بيانات التواصل والموقع"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "عنوان قسم الاتصال",
      "default": "تواصل معنا"
    },
    {
      "type": "text",
      "id": "address",
      "label": "العنوان الفعلي",
      "default": "المملكة العربية السعودية، مدينة عرعر"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "رقم الجوال",
      "default": "0510804290"
    },
    {
      "type": "text",
      "id": "email",
      "label": "البريد الإلكتروني",
      "default": "contact@eilawaters.com"
    },
    {
      "type": "header",
      "content": "البيانات والتوثيقات الرسمية (تحت الشعار)"
    },
    {
      "type": "text",
      "id": "tax_number",
      "label": "رقم التسجيل الضريبي",
      "default": "312183879200003"
    },
    {
      "type": "image_picker",
      "id": "tax_image",
      "label": "أيقونة/صورة الرقم الضريبي (تظهر يميناً بجانب النص)"
    },
    {
      "type": "text",
      "id": "cr_number",
      "label": "رقم السجل التجاري",
      "default": "7038794942"
    },
    {
      "type": "image_picker",
      "id": "cr_image",
      "label": "أيقونة/صورة السجل التجاري (تظهر يميناً بجانب النص)"
    },
    {
      "type": "header",
      "content": "روابط التواصل الاجتماعي (أسفل الفوتر)"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "رابط انستقرام"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "رابط تيك توك"
    },
    {
      "type": "url",
      "id": "social_snapchat",
      "label": "رابط سناب شات"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "رابط منصة X (تويتر سابقاً)"
    },
    {
      "type": "header",
      "content": "تخصيص لوحة الألوان"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "لون الخلفية الرئيسي",
      "default": "#0b0f19"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "لون الخطوط الفاصلة والحدود",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "لون العناوين الرئيسية",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "لون نصوص القوائم والتواصل",
      "default": "#cbd5e1"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "لون النصوص الفرعية/الحقوق",
      "default": "#64748b"
    },
