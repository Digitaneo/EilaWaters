<div class="not-found-section container">
  <span class="error-code">404</span>
  <h1 class="error-title">{{ 'general.404.title' | t }}</h1>
  <p class="error-text">{{ 'general.404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" class="btn btn-primary">Go back home</a>
</div>

<style>
  .not-found-section {
    text-align: center;
    padding: 6rem 0;
  }
  .error-code {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
    display: block;
    margin-bottom: 1rem;
    opacity: 0.15;
  }
  .error-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .error-text {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
</style>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
