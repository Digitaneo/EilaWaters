{%- liquid
  assign is_rtl = false
  if request.locale.iso_code contains 'ar'
    assign is_rtl = true
  endif
-%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

  .promo-showcase-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    direction: rtl;
  }

  .promo-showcase-{{ section.id }} * {
    font-family: 'Cairo', sans-serif !important;
    box-sizing: border-box;
  }

  .promo-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .promo-section-title {
    text-align: center;
    font-size: 32px;
    font-weight: 800;
    color: {{ section.settings.title_color }};
    margin-bottom: 40px;
    position: relative;
  }

  .promo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
  }

  .promo-banner-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease;
    cursor: pointer;
  }

  .promo-banner-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px {{ section.settings.accent_glow_color | color_modify: 'alpha', 0.15 }};
  }

  .promo-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    z-index: 1;
  }

  .promo-banner-card:hover .promo-bg-image {
    transform: scale(1.06);
  }

  .promo-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 80%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.5) 60%, rgba(0, 0, 0, 0) 100%);
    z-index: 2;
  }

  .promo-content {
    position: relative;
    z-index: 3;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transform: translateY(30px);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .promo-banner-card:hover .promo-content {
    transform: translateY(0);
  }

  .promo-badge {
    align-self: flex-start;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text }};
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .promo-title {
    font-size: 26px;
    font-weight: 800;
    margin: 0;
    line-height: 1.3;
    color: #ffffff;
  }

  .promo-description {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    line-height: 1.6;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }

  .promo-banner-card:hover .promo-description {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .promo-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }} !important;
    padding: 12px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    margin-top: 5px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  }

  .promo-action-btn:hover {
    background: {{ section.settings.btn_hover_bg }};
    transform: scale(1.03);
  }

  .promo-action-btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }
  .promo-action-btn:hover svg {
    transform: translateX(-4px);
  }

  @media (max-width: 768px) {
    .promo-section-title {
      font-size: 24px;
      margin-bottom: 25px;
    }
    
    .promo-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 20px;
      padding-right: 4px;
      padding-left: 4px;
      scrollbar-width: none;
    }

    .promo-grid::-webkit-scrollbar {
      display: none;
    }

    .promo-banner-card {
      min-width: 85vw;
      scroll-snap-align: center;
      min-height: 420px;
      padding: 30px 20px;
    }

    .promo-content {
      transform: translateY(0) !important;
    }
    .promo-description {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateY(0) !important;
      font-size: 13px;
    }
    .promo-action-btn {
      width: 100%;
    }
  }
{%- endstyle -%}

<div class="promo-showcase-{{ section.id }}">
  <div class="promo-container">
    
    {% if section.settings.section_title != blank %}
      <h2 class="promo-section-title">{{ section.settings.section_title }}</h2>
    {% endif %}

    <div class="promo-grid">
      {% for block in section.blocks %}
        {% if block.type == 'promo_banner' %}
          {%- assign target_product = all_products[block.settings.featured_product] -%}
          
          <div class="promo-banner-card" onclick="window.location.href='{% if target_product != blank %}{{ target_product.url }}{% else %}#{% endif %}'">
            
            <!-- جلب صورة المنتج تلقائياً كخلفية أو استخدام صورة افتراضية إن لم يتم اختيار منتج -->
            <div class="promo-bg-image" 
                 style="background-image: url('{% if target_product.featured_image != blank %}{{ target_product.featured_image | image_url: width: 800 }}{% else %}https://cdn.shopify.com/s/images/themes/product-1.png{% endif %}');">
            </div>
            
            <div class="promo-overlay"></div>

            <div class="promo-content">
              {% if block.settings.badge_text != blank %}
                <span class="promo-badge">{{ block.settings.badge_text }}</span>
              {% endif %}
              
              <!-- جلب اسم المنتج تلقائياً -->
              <h3 class="promo-title">
                {% if target_product != blank %}
                  {{ target_product.title }}
                {% else %}
                  {{ 'homepage.onboarding.product_title' | t }}
                {% endif %}
              </h3>
              
              {% if block.settings.banner_desc != blank %}
                <p class="promo-description">{{ block.settings.banner_desc }}</p>
              {% endif %}
              
              <!-- الزر موحد وتلقائي لجميع المنتجات -->
              <a href="{% if target_product != blank %}{{ target_product.url }}{% else %}#{% endif %}" class="promo-action-btn">
                <span>تعرف على المزيد</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>

          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Hero Interactive Showcase",
  "settings": [
    {
      "type": "header",
      "content": "إعدادات القسم العامة"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "عنوان القسم الرئيسي",
      "default": "عروض حصرية اخترناها لك"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "لون خلفية القسم",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "لون العنوان الرئيسي",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_glow_color",
      "label": "لون توهج حركية البانر (Glow Effect)",
      "default": "#3b82f6"
    },
    {
      "type": "header",
      "content": "إعدادات الشارات والأزرار"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "خلفية الشارة للبانرات",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "نص الشارة للبانرات",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "خلفية زر التحويل",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "نص زر التحويل",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "خلفية الزر عند التمرير",
      "default": "#f1f5f9"
    },
    {
      "type": "header",
      "content": "المسافات (Padding)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "مسافة علوية",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "مسافة سفلية",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "promo_banner",
      "name": "بانر ترويجي لمنتج",
      "settings": [
        {
          "type": "product",
          "id": "featured_product",
          "label": "اختر المنتج المستهدف (سيتم جلب الاسم والصورة تلقائياً)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "نص الشارة الترويجية",
          "default": "الأكثر مبيعاً"
        },
        {
          "type": "textarea",
          "id": "banner_desc",
          "label": "نص إقناعي قصير مخصص",
          "default": "تصميم فريد يحاكي الطبيعة النقية، تمتع بالجودة القصوى التي يستحقها يومك."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Interactive Showcase",
      "blocks": [
        { "type": "promo_banner" },
        { "type": "promo_banner" }
      ]
    }
  ]
}
{% endschema %}