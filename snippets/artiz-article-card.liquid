{%- comment -%}
  Artiz Theme – Article Card
  Usage: {% render 'artiz-article-card', article: article %}
{%- endcomment -%}

<style>
/* 1. تنسيق بطاقة المقال الفردية ككتلة مستقلة ومنظمة داخل الشبكة */
.artiz-article-card {
    display: flex !important;
    flex-direction: column !important;
    background: #ffffff !important;
    border: 1px solid #eef2f6 !important; /* إطار خفيف وناعم لتحديد كروت المقالات */
    border-radius: 12px !important;
    overflow: hidden !important;
    height: 100% !important; /* لتوحيد ارتفاع الكروت بجانب بعضها تماماً */
    padding: 0 !important;
    margin-bottom: 0 !important;
    box-sizing: border-box !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02); /* ظلال خفيفة لإعطاء مظهر احترافي */
}

/* 2. تثبيت أبعاد غلاف الصورة ومنع ظهور صور بأحجام متفاوتة */
.artiz-article-card__image-link {
    display: block !important;
    width: 100% !important;
    height: 220px !important; /* الارتفاع المثالي لشبكة الـ 3 مقالات */
    overflow: hidden !important;
    position: relative !important;
}

.artiz-article-card__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important; /* قص ذكي وتلقائي للصورة دون تشويه أبعادها */
    transition: transform 0.3s ease !important;
}

.artiz-article-card:hover .artiz-article-card__image {
    transform: scale(1.04) !important; /* حركة تفاعلية ناعمة لغلاف المقال عند تمرير الماوس */
}

/* 3. ضبط المسافات الداخلية للمحتوى النصي عن الحواف */
.artiz-article-card__content {
    padding: 20px 16px !important; /* مسافة أمان ممتازة لحماية النصوص من الالتصاق حواف الكارت */
    display: flex !important;
    flex-direction: column !important;
    flex-grow: 1 !important;
}

.artiz-article-card__date {
    display: block !important;
    font-size: 13px !important;
    color: #888888 !important;
    margin-bottom: 8px !important;
}

.artiz-article-card__title {
    margin: 0 0 10px 0 !important;
    font-size: 18px !important;
    line-height: 1.5 !important;
    font-weight: bold !important;
}

.artiz-article-card__title a {
    text-decoration: none !important;
    color: #1e293b !important; /* لون داكن مريح للعين */
    transition: color 0.2s ease !important;
}

.artiz-article-card__title a:hover {
    color: #0284c7 !important; /* يتحول للون أزرق إيلا عند الشير بالماوس */
}

.artiz-article-card__excerpt {
    font-size: 14px !important;
    color: #475569 !important;
    line-height: 1.6 !important;
    margin-bottom: 20px !important;
    flex-grow: 1 !important; /* لدفع زر القراءة لأسفل البطاقة دائماً وتوحيد الأسطر */
}

.artiz-article-card__footer {
    margin-top: auto !important;
}

.artiz-article-card__link {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-size: 14px !important;
    font-weight: bold !important;
    color: #0284c7 !important; /* اللون المعتمد لهوية متجر إيلا للمياه */
    text-decoration: none !important;
}

/* 4. تجاوب أبعاد الكارت والصور مع شاشات الجوال */
@media screen and (max-width: 768px) {
    .artiz-article-card__image-link {
        height: 190px !important; /* تقليل حجم الصورة لتناسب الشاشات الصغيرة */
    }
    .artiz-article-card__title {
        font-size: 16px !important;
    }
    .artiz-article-card__content {
        padding: 16px 12px !important;
    }
}
</style>

<article class="artiz-article-card">
  <a href="{{ article.url }}" class="artiz-article-card__image-link">
    {%- if article.image -%}
      <img 
        src="{{ article.image | img_url: '600x400', crop: 'center' }}" 
        alt="{{ article.image.alt | escape }}" 
        class="artiz-article-card__image"
        loading="lazy"
        width="600"
        height="400"
      >
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'artiz-article-card__image' }}
    {%- endif -%}
  </a>

  <div class="artiz-article-card__content">
    <span class="artiz-article-card__date">{{ article.published_at | time_tag: format: 'date' }}</span>
    <h3 class="artiz-article-card__title">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </h3>
    <div class="artiz-article-card__excerpt">
      {%- if article.excerpt.size > 0 -%}
        {{ article.excerpt | strip_html | truncate: 120 }}
      {%- else -%}
        {{ article.content | strip_html | truncate: 120 }}
      {%- endif -%}
    </div>
    <div class="artiz-article-card__footer">
      <a href="{{ article.url }}" class="artiz-article-card__link">
        {{ read_more_label | default: 'اقرأ المزيد' }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="transform: scaleX(-1);"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</article>