{%- comment -%}
  Artiz Theme – Article Card
  Usage: {% render 'artiz-article-card', article: article %}
{%- endcomment -%}

<style>
/* 1. إخفاء عنوان الصفحة الرئيسي وأزرار الوسوم لمنع التشوه البصري */
.main-blog h1, 
.blog-title,
[class*="blog"] h1,
.artiz-blog__tags,
.blog-tags,
[class*="tags"] {
    display: none !important;
}

/* 2. تنسيق بطاقة المقال الفردية لتبدو ككتلة منظمة */
.artiz-article-card {
    display: flex !important;
    flex-direction: column !important;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    height: 100%; /* لتوحيد ارتفاع الكروت بجانب بعضها */
    padding: 0 !important;
    margin-bottom: 20px !important;
    box-sizing: border-box;
}

/* 3. توحيد مقاس غلاف الصورة لمنع ظهور صور أكبر من أخرى */
.artiz-article-card__image-link {
    display: block !important;
    width: 100% !important;
    height: 220px !important; /* ارتفاع مثالي ومتناسق للصور */
    overflow: hidden !important;
    position: relative;
}

.artiz-article-card__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important; /* قص تلقائي ذكي للصورة دون تشويه أبعادها */
    transition: transform 0.3s ease;
}

.artiz-article-card:hover .artiz-article-card__image {
    transform: scale(1.03); /* تأثير حركة ناعم عند تمرير الماوس */
}

/* 4. ضبط محاذاة النصوص والمسافات الداخلية عن الحواف */
.artiz-article-card__content {
    padding: 20px 12px 15px 12px !important;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.artiz-article-card__date {
    display: block;
    font-size: 13px;
    color: #888888;
    margin-bottom: 8px;
}

.artiz-article-card__title {
    margin: 0 0 10px 0 !important;
    font-size: 18px !important;
    line-height: 1.4 !important;
    font-weight: bold;
}

.artiz-article-card__title a {
    text-decoration: none !important;
    color: #222222 !important;
}

.artiz-article-card__excerpt {
    font-size: 14px;
    color: #555555;
    line-height: 1.6;
    margin-bottom: 15px;
    flex-grow: 1; /* دفع زر القراءة لأسفل الكارت دائماً */
}

.artiz-article-card__footer {
    margin-top: auto;
}

.artiz-article-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: bold;
    color: #0284c7 !important; /* لون أزرق مائي متناسق مع هوية إيلا للمياه */
    text-decoration: none !important;
}

/* دعم شاشات الجوال */
@media screen and (max-width: 768px) {
    .artiz-article-card__image-link {
        height: 180px !important;
    }
    .artiz-article-card__title {
        font-size: 16px !important;
    }
}
</style>

<article class="artiz-article-card">
  <a href="{{ article.url }}" class="artiz-article-card__image-link">
    {%- if article.image -%}
      <img 
        src="{{ article.image | img_url: '600x400', crop: 'center' }}" 
        alt="{{ article.image.alt | escape }}" 
        class="artiz-article-card__image"
        loading="lazy"
        width="600"
        height="400"
      >
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'artiz-article-card__image' }}
    {%- endif -%}
  </a>

  <div class="artiz-article-card__content">
    <span class="artiz-article-card__date">{{ article.published_at | time_tag: format: 'date' }}</span>
    <h3 class="artiz-article-card__title">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </h3>
    <div class="artiz-article-card__excerpt">
      {%- if article.excerpt.size > 0 -%}
        {{ article.excerpt | strip_html | truncate: 120 }}
      {%- else -%}
        {{ article.content | strip_html | truncate: 120 }}
      {%- endif -%}
    </div>
    <div class="artiz-article-card__footer">
      <a href="{{ article.url }}" class="artiz-article-card__link">
        {{ read_more_label | default: 'اقرأ المزيد' }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="transform: scaleX(-1);"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</article>