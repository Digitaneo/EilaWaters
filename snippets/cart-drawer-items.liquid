{%- liquid
  assign is_rtl = false
  if request.locale.iso_code contains 'ar'
    assign is_rtl = true
  endif
-%}

<style>
/* تطبيق خط Cairo وتنسيق قسم مواعيد التسليم */
.cart-drawer__delivery-properties,
.cart-drawer__summary,
.cart-drawer__delivery-properties * {
  font-family: 'Cairo', sans-serif !important;
}
.cart-drawer__delivery-properties {
  margin: 20px 0;
  padding: 18px;
  background: #ffffff;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}
.cart-drawer__delivery-title {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 12px;
  color: #1a202c;
  display: flex;
  align-items: center;
  gap: 6px;
}
.cart-drawer__property-group {
  margin-bottom: 14px;
}
.cart-drawer__property-group:last-child {
  margin-bottom: 0;
}
.cart-drawer__property-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
  color: #4a5568;
  text-align: right;
}
.cart-drawer__property-group input,
.cart-drawer__property-group select {
  width: 100%;
  padding: 11px 14px;
  font-size: 14px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background-color: #fff;
  box-sizing: border-box;
  transition: all 0.2s ease;
  color: #1a202c;
}
.cart-drawer__property-group input:focus,
.cart-drawer__property-group select:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 213, 0.15);
}
/* تنسيق الخيارات عند التعطيل بسبب الوقت */
select option:disabled {
  color: #ef4444 !important;
  background-color: #fef2f2;
}
.delivery-error-msg {
  display: none;
  color: #ef4444;
  font-size: 12px;
  font-weight: 600;
  margin-top: 6px;
  text-align: right;
}
.cart-drawer__summary {
  margin: 15px 0;
  padding-top: 12px;
  border-top: 1px solid #edf2f7;
}
.cart-drawer__summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  margin-bottom: 6px;
  color: #4a5568;
}
.cart-drawer__summary-row.total {
  font-size: 16px;
  font-weight: 700;
  color: #1a202c;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px dashed #cbd5e1;
}
.cart-drawer__footer-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}
.cart-drawer__clear {
  color: #ef4444 !important;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}
</style>

{%- if cart.item_count > 0 -%}
  <div class="cart-drawer__items-wrapper" {% if is_rtl %}dir="rtl"{% endif %}>
    {%- for item in cart.items -%}
      <div class="cart-drawer__item" data-key="{{ item.key }}">
        <div class="cart-drawer__item-image">
          {%- if item.image != blank -%}
            {{ item.image | image_url: width: 150 | image_tag: loading: 'lazy' }}
          {%- endif -%}
        </div>

        <div class="cart-drawer__item-info">
          <div class="cart-drawer__item-header">
            <h3 class="cart-drawer__item-title">
              <a href="{{ item.url }}">{{ item.product.title }}</a>
            </h3>
            <button type="button" class="cart-drawer__item-remove" data-line="{{ forloop.index }}" aria-label="{% if is_rtl %}إزالة المنتج{% else %}Remove item{% endif %}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
              </svg>
            </button>
          </div>
          
          {%- unless item.product.has_only_default_variant -%}
            <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
          {%- endunless -%}

          <div class="cart-drawer__item-meta">
            <span class="cart-drawer__item-price">{{ item.final_price | money }}</span>
            
            <div class="cart-drawer__qty-selector">
              <button type="button" class="qty-btn minus-qty" aria-label="{% if is_rtl %}تقليل الكمية{% else %}Decrease quantity{% endif %}">-</button>
              <input type="number" class="cart-drawer__qty-input" data-line="{{ forloop.index }}" value="{{ item.quantity }}" min="0" readonly>
              <button type="button" class="qty-btn plus-qty" aria-label="{% if is_rtl %}زيادة الكمية{% else %}Increase quantity{% endif %}">+</button>
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="cart-drawer__footer" {% if is_rtl %}dir="rtl"{% endif %}>
    <div class="cart-drawer__footer-actions">
      <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__add-more header-cart-trigger-close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>{{ 'cart.add_more' | t }}</span>
      </a>

      <a href="/cart/clear" class="cart-drawer__clear" id="CartDrawerClearBtn">
        {% if is_rtl %}إفراغ السلة{% else %}{{ 'cart.clear' | t }}{% endif %}
      </a>
    </div>

    <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout-form" id="CartDrawerForm">
      
      <div class="cart-drawer__delivery-properties">
        <div class="cart-drawer__delivery-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>{% if is_rtl %}جدولة تفاصيل التوصيل{% else %}Delivery Scheduling{% endif %}</span>
        </div>

        <div class="cart-drawer__property-group">
          <label for="Delivery-Date">{% if is_rtl %}تاريخ التوصيل المفضل :{% else %}Preferred Delivery Date:{% endif %}</label>
          <input type="date" id="Delivery-Date" name="attributes[تاريخ التوصيل المفضل]" value="{{ cart.attributes['تاريخ التوصيل المفضل'] }}" required>
        </div>

        <div class="cart-drawer__property-group">
          <label for="Delivery-Time">{% if is_rtl %}توقيت التوصيل المناسب :{% else %}Preferred Delivery Time:{% endif %}</label>
          <select id="Delivery-Time" name="attributes[توقيت التوصيل المناسب]">
            <option value="الصباح (9:00 صباحاً - 1:00 مساءً)" id="opt-morning">{% if is_rtl %}الصباح (9:00 صباحاً - 1:00 مساءً){% else %}Morning (9:00 AM - 1:00 PM){% endif %}</option>
            <option value="المساء (2:00 مساءً - 7:00 مساءً)" id="opt-evening">{% if is_rtl %}المساء (2:00 مساءً - 7:00 مساءً){% else %}Afternoon (2:00 PM - 7:00 PM){% endif %}</option>
          </select>
          <div class="delivery-error-msg" id="delivery-error"></div>
        </div>
      </div>

      <div class="cart-drawer__summary">
        <div class="cart-drawer__summary-row">
          <span>{% if is_rtl %}عدد المنتجات:{% else %}Total Items:{% endif %}</span>
          <span>{{ cart.item_count }}</span>
        </div>
        <div class="cart-drawer__summary-row total">
          <span>{% if is_rtl %}المجموع الإجمالي:{% else %}Subtotal:{% endif %}</span>
          <span class="cart-drawer__total-price">{{ cart.total_price | money }}</span>
        </div>
      </div>

      <button type="submit" name="checkout" class="btn btn-primary cart-drawer__checkout-btn" style="width: 100%;">
        <span>{{ 'cart.checkout' | t }}</span>
        <span> - {{ cart.total_price | money }}</span>
      </button>
    </form>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const dateInput = document.getElementById('Delivery-Date');
    const timeSelect = document.getElementById('Delivery-Time');
    const optMorning = document.getElementById('opt-morning');
    const optEvening = document.getElementById('opt-evening');
    const errorMsg = document.getElementById('delivery-error');
    const checkoutForm = document.getElementById('CartDrawerForm');

    // دالة جلب التاريخ الحالي بصيغة YYYY-MM-DD المتوافقة مع المتصفحات
    function getLocalDateString(dateObj) {
      const offset = dateObj.getTimezoneOffset();
      const localDate = new Date(dateObj.getTime() - (offset * 60 * 1000));
      return localDate.toISOString().split('T')[0];
    }

    function validateDeliveryTime() {
      const now = new Date();
      const currentHour = now.getHours();
      const todayStr = getLocalDateString(now);
      const selectedDateStr = dateInput.value;

      // إعادة ضبط الخيارات افتراضياً
      optMorning.disabled = false;
      optMorning.style.color = "";
      optEvening.disabled = false;
      optEvening.style.color = "";
      errorMsg.style.display = "none";

      // إذا كان التاريخ المختار هو اليوم الحالي، يتم تطبيق قيود الـ 2 ساعات
      if (selectedDateStr === todayStr) {
        
        // 1. قيد الفترة الصباحية: تنتهي 13:00 (آخر موعد متاح بفرق ساعتين هو الساعة 11:00 صباحاً)
        if (currentHour >= 11) {
          optMorning.disabled = true;
          optMorning.style.color = "#ef4444";
          
          if (timeSelect.value === "الصباح (9:00 صباحاً - 1:00 مساءً)") {
            timeSelect.value = "المساء (2:00 مساءً - 7:00 مساءً)";
            errorMsg.innerText = "الفترة الصباحية غير متاحة الآن، تم التغيير للمساء تلقائياً.";
            errorMsg.style.display = "block";
          }
        }

        // 2. قيد الفترة المسائية: تنتهي 19:00 (آخر موعد متاح بفرق ساعتين هو الساعة 17:00 / 5 مساءً)
        if (currentHour >= 17) {
          optEvening.disabled = true;
          optEvening.style.color = "#ef4444";

          // إذا انتهت الفترتان لليوم الحالي، نقوم بتوجيه العميل لليوم التالي تلقائياً
          const tomorrow = new Date();
          tomorrow.setDate(now.getDate() + 1);
          dateInput.value = getLocalDateString(tomorrow);
          timeSelect.value = "الصباح (9:00 صباحاً - 1:00 مساءً)";
          
          errorMsg.innerText = "انتهت فترات التوصيل لليوم، تم الانتقال لصباح الغد الموالي.";
          errorMsg.style.display = "block";
          
          // إعادة تفعيل الخيارات ليوم غد
          optMorning.disabled = false;
          optMorning.style.color = "";
          optEvening.disabled = false;
          optEvening.style.color = "";
        }
      }
    }

    if (dateInput && timeSelect) {
      const now = new Date();
      const todayStr = getLocalDateString(now);
      
      // تعيين الحد الأدنى والتاريخ الافتراضي ليظهر فوراً
      dateInput.min = todayStr;
      if (!dateInput.value) {
        dateInput.value = todayStr;
      }

      // فحص أولي للوقت المتاح
      validateDeliveryTime();

      // الاستماع لأي تغيير يقوم به العميل في التاريخ أو وقت التوصيل
      dateInput.addEventListener('change', validateDeliveryTime);
      timeSelect.addEventListener('change', function() {
        const currentHour = now.getHours();
        if (dateInput.value === todayStr) {
          if (timeSelect.value === "الصباح (9:00 صباحاً - 1:00 مساءً)" && currentHour >= 11) {
            alert("هذه الفترة لم تعد متاحة للتوصيل اليوم.");
            validateDeliveryTime();
          }
        }
      });
    }

    // منع العميل من الدفع في حال وجود أي تلاعب أو اختيار خاطئ
    if (checkoutForm) {
      checkoutForm.addEventListener('submit', function(e) {
        const now = new Date();
        if (dateInput.value === getLocalDateString(now)) {
          if (timeSelect.value === "الصباح (9:00 صباحاً - 1:00 مساءً)" && now.getHours() >= 11) {
            e.preventDefault();
            alert("يرجى اختيار فترة توصيل متاحة قبل إتمام الطلب.");
          }
        }
      });
    }

    // تفاعل زر إفراغ السلة الفوري
    const clearBtn = document.getElementById('CartDrawerClearBtn');
    if (clearBtn) {
      clearBtn.addEventListener('click', function(e) {
        e.preventDefault();
        fetch('/cart/clear.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        })
        .then(() => { window.location.reload(); })
        .catch(() => { window.location.href = '/cart/clear'; });
      });
    }
  });
  </script>
{%- else -%}
  <div class="cart-drawer__empty" {% if is_rtl %}dir="rtl"{% endif %} style="font-family: 'Cairo', sans-serif !important;">
    <div class="empty-icon">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
    </div>
    <p class="empty-text">{{ 'cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary header-cart-trigger-close">{{ 'cart.add_more' | t }}</a>
  </div>
{%- endif -%}